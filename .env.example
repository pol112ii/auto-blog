# 구글 클라우드 콘솔 > OAuth 2.0 클라이언트 ID (데스크톱 앱)
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=

# blogger_auth.py 를 한 번 실행해서 받은 값
BLOGGER_REFRESH_TOKEN=

# 블로그 주소만 넣으면 ID 는 알아서 찾는다.
BLOGGER_BLOG_URL=https://information.ggudol.com/
# ID 를 이미 알고 있다면 이쪽을 채워도 된다. 이게 있으면 위 주소는 무시된다.
BLOGGER_BLOG_ID=

# 네이버 블로그 아이디 (기본값).
# 블로그가 여러 개면 keywords.csv 의 naver_blog_id 칸에 줄마다 따로 적거나,
# /newpost <키워드> <아이디> 처럼 그때그때 지정하면 이 값을 덮어쓴다.
NAVER_BLOG_ID=njibgt

# 네이버 검색광고 API (키워드도구). 없으면 검색량 없이 후보만 나온다.
# https://manage.searchad.naver.com > 도구 > API 사용관리
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=
